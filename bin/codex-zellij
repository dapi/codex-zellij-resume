#!/bin/sh
# Start an interactive Codex session that Zellij can resurrect precisely.
set -eu

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/codex-zellij-resume"
MARKER_DIR="$STATE_DIR/markers"
CODEX_BIN="${CODEX_BIN:-codex}"

usage() {
  printf '%s\n' 'usage: codex-zellij [codex arguments]'
}

first_command() {
  for arg in "$@"; do
    case "$arg" in
      --) return 0 ;;
      -*) ;;
      *) printf '%s\n' "$arg"; return 0 ;;
    esac
  done
}

# Commands that cannot create an interactive session are deliberately not
# wrapped. This avoids creating meaningless marker files for administration
# and one-shot commands.
case "$(first_command "$@")" in
  exec|e|review|login|logout|mcp|mcp-server|app-server|completion|sandbox|debug|apply|a|cloud|features|help)
    exec "$CODEX_BIN" "$@"
    ;;
esac

MARKER=""
if [ "${1:-}" = "--zellij-marker" ] && [ -n "${2:-}" ]; then
  MARKER="$2"
  shift 2
fi

if [ -z "$MARKER" ]; then
  if command -v uuidgen >/dev/null 2>&1; then
    MARKER="$(uuidgen)"
  else
    MARKER="$(date +%s)-$$"
  fi
  # Re-exec so the marker is part of the process command line that Zellij
  # serializes. The resurrection hook later reads this exact marker.
  exec "$0" --zellij-marker "$MARKER" "$@"
fi

case "$MARKER" in
  *[!A-Za-z0-9-]*|'')
    printf '%s\n' 'codex-zellij: invalid marker' >&2
    exit 2
    ;;
esac

mkdir -p "$MARKER_DIR"
MARKER_FILE="$MARKER_DIR/$MARKER"

if [ -s "$MARKER_FILE" ]; then
  SESSION_ID="$(tr -d '\r\n' < "$MARKER_FILE")"
  if [ -n "$SESSION_ID" ]; then
    exec "$CODEX_BIN" resume "$SESSION_ID" --no-alt-screen
  fi
fi

PROXY="$(dirname "$0")/codex-zellij-pty.py"
if ! command -v python3 >/dev/null 2>&1 || [ ! -f "$PROXY" ]; then
  printf '%s\n' 'codex-zellij: Python 3 proxy is required' >&2
  exit 1
fi

# The proxy watches the first submitted prompt, not process startup. This lets
# several empty panes open concurrently and serializes only the operation that
# makes Codex create a session-index record.
exec python3 "$PROXY" --zellij-marker "$MARKER" -- "$CODEX_BIN" --no-alt-screen "$@"
